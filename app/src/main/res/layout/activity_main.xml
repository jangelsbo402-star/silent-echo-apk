<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B10"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XFINITY O-S // SILENT ECHO (1 × 1 = 3)"
        android:textColor="#7DD3FC"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ZONE: SCANNING"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGuidance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Rotate Wandow slowly to map directional field."
        android:textColor="#E2E8F0"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvVector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#111827"
        android:padding="12dp"
        android:text="◀ LEFT   |   ▲ AHEAD 0° (North)   |   RIGHT ▶"
        android:textColor="#38BDF8"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvCymatic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#111827"
        android:padding="12dp"
        android:text="Cymatic Node: 7.83 Hz Baseline · Tilt: LEVEL (0°)"
        android:textColor="#A7F3D0"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPulse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cymatic Pulse" />

        <Button
            android:id="@+id/btnLock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Lock Vector: OFF" />
    </LinearLayout>

</LinearLayout>
